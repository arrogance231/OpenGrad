{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "model",
    "checkpoint",
    "runtime",
    "device",
    "metrics"
  ],
  "properties": {
    "model": {
      "type": "string"
    },
    "checkpoint": {
      "type": "string"
    },
    "quantization": {
      "type": [
        "string",
        "null"
      ]
    },
    "runtime": {
      "type": "string"
    },
    "device": {
      "type": "string"
    },
    "metrics": {
      "type": "object"
    }
  }
}
